{
  "name": "shanghai-school-compass",
  "private": true,
  "version": "2026.09.11-governance-alpha.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "validate:data": "esbuild scripts/validate-data.ts --bundle --platform=node --format=esm --outfile=/tmp/shanghai-school-compass-validate.mjs && node /tmp/shanghai-school-compass-validate.mjs",
    "validate:prod": "esbuild scripts/validate-data.ts --bundle --platform=node --format=esm --outfile=/tmp/shanghai-school-compass-validate.mjs && RELEASE_MODE=production node /tmp/shanghai-school-compass-validate.mjs",
    "ci": "npm run validate:data && npx tsc --noEmit && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
